# ---------------------------------------------------------------------------
# Team admv — single source of truth for addresses.
# Every script in scripts/ sources this file. If the lab Wi-Fi hands out new
# addresses on demo day, change them HERE ONLY and re-run scripts/preflight.sh.
#
# (The nginx/dnsmasq configs still carry literal IPs, because those files are
#  copied onto each laptop by hand — grep for the old IP if they change.)
# ---------------------------------------------------------------------------
DOMAIN="app.admv.test"
API_DOMAIN="api.admv.test"

DNS_PRIMARY="10.7.3.140"      # Vaibhav  — Mac 1 — dnsmasq
DNS_BACKUP="10.7.24.165"      # Dikshant — Mac 4 — backup dnsmasq      (Ext A)
EDGE="10.7.25.158"            # Mukul    — Mac 2 — nginx primary edge
EDGE_STANDBY="10.7.24.165"    # Dikshant — Mac 4 — nginx standby edge  (Ext E)
BACKEND_A="10.7.29.240"       # Ashish   — Mac 3 — REST backend A :3001
BACKEND_B="10.7.24.165"       # Dikshant — Mac 4 — REST backend B :3002

PORT_A=3001
PORT_B=3002
HTTPS_PORT=443                # change to 8443 if 443 cannot be bound
